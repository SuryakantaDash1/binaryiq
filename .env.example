# ─── Core ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Postgres 15) ─────────────────────────────────────────
# Local (docker-compose): pooled and direct point at the same instance.
# Hosted/production: use TLS with certificate verification (sslmode=verify-full).
DATABASE_URL=postgresql://app:app@localhost:5432/influencer?schema=public
DIRECT_URL=postgresql://app:app@localhost:5432/influencer?schema=public

# ─── Redis 7 ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (RS256 JWT) — REQUIRED ────────────────────────────────────
# Base64-encoded PEM keypair. Generate:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem   (and public.pem)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_ACCESS_TTL=15m
ADMIN_SESSION_TTL=8h

# ─── Encryption (AES-256-GCM) — REQUIRED ────────────────────────────
# 32-byte key as 64 hex chars:  openssl rand -hex 32
# Personal data is unreadable without this key: keep it in a secret manager
# in production and never reuse the dev key.
ENCRYPTION_KEY=

# ─── Survey return-token HMAC — REQUIRED (min 32 chars) ─────────────
#   openssl rand -hex 32
SURVEY_CALLBACK_SECRET=

# ─── Business constants ─────────────────────────────────────────────
POINTS_PER_INR=100
REGISTRATION_BONUS_POINTS=500

# ─── Web app base URL (for email links) ─────────────────────────────
WEB_URL=http://localhost:3000

# ─── HTTP hardening ─────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (defaults to WEB_URL).
CORS_ORIGINS=
# Number of reverse proxies in front of the API (0 = direct connection).
TRUST_PROXY=0

# Testing only — instantly verifies new accounts. Rejected when NODE_ENV=production.
AUTO_VERIFY_EMAIL=false

# ─── Seed (super-admin bootstrap) ───────────────────────────────────
SEED_SUPERADMIN_EMAIL=admin@influencerplatform.app
SEED_SUPERADMIN_PASSWORD=

# ─── Web (browser-exposed) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# ─── Providers ──────────────────────────────────────────────────────
# Email: one provider is required in production (no console fallback).
# Resend is tried first if both its vars are set, else SendGrid.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@influencerplatform.app
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@influencerplatform.app
# Webhooks are rejected until their verification secret is configured.
SENDGRID_WEBHOOK_VERIFICATION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
FCM_WEBHOOK_SECRET=
